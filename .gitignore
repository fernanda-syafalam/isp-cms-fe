# ============================================
# Dependencies
# ============================================
node_modules/
.pnpm-store/

# ============================================
# Build output
# ============================================
dist/
build/

# tsc -b composite build emit (config file outputs + buildinfo)
*.tsbuildinfo
vite.config.js
vite.config.d.ts
playwright.config.js
playwright.config.d.ts

# ============================================
# Env (never commit — use .env.example as template)
# ============================================
.env
.env.local
.env.*.local

# ============================================
# Test artifacts
# ============================================
# Anchored to repo root so it doesn't swallow src/features/coverage/
/coverage/
playwright-report/
test-results/
.vite/
.vitest-cache/

# ============================================
# Logs
# ============================================
*.log
npm-debug.log*
pnpm-debug.log*

# ============================================
# OS / editor
# ============================================
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# ============================================
# Claude Code artifacts
# ============================================

# Claude Code local state (keep settings.json and commands/ committed)
.claude/cache/
.claude/logs/
.claude/sessions/
.claude/.local/

# Local-only Claude settings overrides
.claude/settings.local.json

# Editor / AI tool caches
.cursor/
.cody/
.aider*
.continue/

# ============================================
# What to KEEP committed in .claude/
# ============================================
# - .claude/settings.json       (team config)
# - .claude/commands/*.md       (shared slash commands)
# - .claude/agents/*.md         (shared subagents)

# Personal/global Claude skills must not live in the repo
.claude/skills/

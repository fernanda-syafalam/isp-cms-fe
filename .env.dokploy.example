# Production BUILD-TIME config for the Dokploy Compose deployment of isp-cms-fe.
#
# These are BUILD ARGS, not runtime env: Vite inlines them into the
# bundle at build time, so a change requires a rebuild/redeploy. They
# are PUBLIC (they ship in the client bundle) — never put secrets here.
#
# In Dokploy, set them in the service's Environment tab; compose passes
# them to the Dockerfile via build.args.

# Real backend base URL, INCLUDING the /v1 version prefix. Cross-origin
# to the FE (subdomain topology) — the backend CORS_ORIGINS must list
# this FE origin and allow credentials.
VITE_API_BASE_URL=https://api.example.com/v1

VITE_APP_NAME=isp-cms
